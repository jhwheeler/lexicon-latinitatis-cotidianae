      ],
      "comment": "Traupman prints <span lang=\"la\">bubulus</span>, a slip for <span lang=\"la\">būbalus</span>; later the word passed to the buffalo."
    },
    {
      "latin": "addax, addācis m.",
      "status": "alternative",
      "period": "classical",
      "gloss": "an African antelope with twisted horns, the addax",
      "evidence": [
        "Plin. NH 11.124 (Lewis &amp; Short)"
      ],
      "comment": "An African word, according to Pliny; the animal still bears the name."
    },
    {
      "latin": "tarandrus, tarandrī m.",
      "status": "avoid",
      "period": "classical",
      "gloss": "not an antelope: the reindeer",
