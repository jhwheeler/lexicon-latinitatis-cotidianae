    {
      "latin": "pēra dorsuālis",
      "status": "recommended",
      "period": "ours",
      "comment": "Our household word: <span lang=\"la\">pēra</span>, a bag or wallet (Phaedr. 4.10.1; Mart. 4.53.3, Lewis &amp; Short), with <span lang=\"la\">dorsuālis</span>, of the back (Apuleius, Lewis &amp; Short). The reference works offer Horace’s <span lang=\"la\">mantica</span> and the modern <span lang=\"la\">saccus dorsuālis</span> and <span lang=\"la\">saccipērium dorsuāle</span> (below)."
    },
    {
      "latin": "mantica, manticae f.",
      "status": "alternative",
      "period": "classical",
      "gloss": "a knapsack, a travelling bag",
      "evidence": [
        "Hor. S. 1.6.106; Catull. 22.21 (Lewis &amp; Short)",
        "Traupman 275"
      ]
    },
    {
      "latin": "saccus dorsuālis",
      "status": "alternative",
      "period": "modern",
      "gloss": "backpack, rucksack",
      "evidence": [
        "M-O s.v. backpack, rucksack"
      ],
      "comment": "Morgan–Owens prefers it to Egger’s <span lang=\"la\">saccipērium dorsuāle</span>, since <span lang=\"la\">saccipērium</span> occurs only once and its meaning is unclear."
    },
    {
      "latin": "saccipērium dorsuāle",
      "status": "alternative",
      "period": "modern",
      "gloss": "knapsack",
      "evidence": [
        "Traupman 336"
      ],
      "comment": "<span lang=\"la\">Saccipērium</span> is Plautus’ word for a pocket or pouch to carry a purse in (Rud. 2.6.64, Lewis &amp; Short)."
    }
  ],
