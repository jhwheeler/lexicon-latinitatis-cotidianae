  "phrases": [
    {
      "latin": "lupus arguēbat vulpem fūrtī crīmine; negābat illa sē esse culpae proximam",
      "english": "the wolf charged the fox with theft; she denied that she was anywhere near guilty",
      "source": "Phaedr. 1.10.4–5"
    },
    {
