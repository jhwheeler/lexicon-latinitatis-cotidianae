      "latin": "vetus atque probus",
      "status": "recommended",
      "period": "classical",
      "gloss": "old and good, of proven worth",
      "evidence": [
        "Hor. Ep. 2.1.39"
      ],
      "comment": "Horace’s words for a poem that has stood the test of time, in his mockery of the rule that a book becomes a classic at a hundred years. <span lang=\"la\">Probus</span> is good, sound, of proven quality, of coins and goods as of people (Lewis &amp; Short: <span lang=\"la\">nummī probī</span>, Plaut.)."
    },
    {
      "latin": "classicus, classica, classicum",
      "status": "alternative",
      "period": "modern",
      "gloss": "classic, of the first rank",
      "evidence": [
        "M-O s.v. classic: <span lang=\"la\">liber classicus</span> (1726)"
      ],
      "comment": "Gellius’s word for a first-rank author (see classic, an author), stretched in modern Latin to any work of lasting worth."
    },
    {
      "latin": "nōbilis, nōbile",
      "status": "alternative",
      "period": "classical",
      "gloss": "famous, well known",
      "evidence": [
        "Lewis &amp; Short, s.v. <span lang=\"la\">nōbilis</span>"
      ],
      "comment": "For a work everybody knows (see famous)."
    }
  ],
  "phrases": [
