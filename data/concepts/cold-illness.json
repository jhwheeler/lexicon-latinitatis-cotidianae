    {
      "latin": "gravēdō, gravēdinis f.",
      "status": "recommended",
      "period": "classical",
      "gloss": "heaviness, especially a cold in the head or catarrh",
      "evidence": [
        "Catull. 44.13–14",
        "Traupman 56: <span lang=\"la\">gravēdine labōrās</span>, you’re suffering from a cold",
        "Traupman 63: <span lang=\"la\">gravēdinem contrahere</span>, to catch a cold; <span lang=\"la\">gravēdine labōrāre</span>, to have a cold",
        "Traupman 61",
        "Traupman 293"
      ],
      "comment": "Useful for “a cold,” without claiming an exact ancient diagnosis of a modern viral infection. Formed from <strong lang=\"la\">gravis</strong>, “heavy”."
    },
    {
      "latin": "corȳza, corȳzae f.",
      "status": "alternative",
      "period": "late",
      "gloss": "catarrh",
      "comment": "A Greek medical loan, attested in Late Latin; it represents Greek κόρυζα."
    },
    {
      "latin": "dēstīllātiō, dēstīllātiōnis f.",
      "status": "alternative",
      "period": "classical",
      "gloss": "dripping or discharge; catarrh in medical contexts",
      "evidence": [
        "Traupman 65: <span lang=\"la\">dēstīllātiōnēs</span>, runny nose"
      ]
    }
  ],
