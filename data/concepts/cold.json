  "phrases": [
    {
      "latin": "Frīgida est! Manūs meae frīgent!",
      "english": "It’s cold! My hands are cold!",
      "source": "composed"
    },
    {
      "latin": "Est frīgidum hodiē.",
      "english": "It’s cold today.",
      "source": "Traupman 132"
    },
    {
