    },
    {
      "latin": "Comede, priusquam frīgēscat.",
      "english": "Eat it before it gets cold.",
      "source": "composed"
    },
    {
      "latin": "Ubi id vīnum refrīxerit, in dōlium quadrāgēnārium īnfunditō.",
      "english": "When the wine has cooled, pour it into a forty-amphora jar.",
      "source": "Cato Agr. 105"
    },
    {
      "latin": "Hoc jūs frīgidum appositum est; calefac, quaesō.",
      "english": "This soup was served cold; please heat it up.",
