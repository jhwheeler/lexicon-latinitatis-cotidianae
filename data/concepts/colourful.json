      "period": "classical",
      "gloss": "many-coloured",
      "evidence": [
        "Plin. NH 37.167 (Lewis &amp; Short)"
      ],
      "comment": "Rare; Lewis &amp; Short marks it post-Augustan."
    }
  ],
