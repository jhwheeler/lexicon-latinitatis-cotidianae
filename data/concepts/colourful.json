    {
      "latin": "versicolor, versicolōris",
      "status": "recommended",
      "period": "classical",
      "gloss": "of many colours, changing colour",
      "evidence": [
        "Cic. Fin. 3.18: <span lang=\"la\">plūmae versicolōrēs columbīs</span>",
        "Liv. 7.10: <span lang=\"la\">vestis versicolor</span> (Lewis &amp; Short)",
        "Ov. F. 5.356: <span lang=\"la\">cultū versicolōre</span>"
      ],
      "comment": "From <span lang=\"la\">versō</span> and <span lang=\"la\">color</span>: of colours that change as the light turns, like a dove’s neck, and so of anything many-coloured, clothes, flowers, sails."
    },
    {
      "latin": "varius, varia, varium",
      "status": "alternative",
      "period": "classical",
      "gloss": "variegated, mottled, of different colours",
      "evidence": [
        "Ter. Eun. 683: <span lang=\"la\">variā veste exōrnātus</span>",
        "Varr. LL 5.100: <span lang=\"la\">tigris quī est ut leō varius</span>"
      ],
      "comment": "Spotted, striped, or patched with colours, as a tiger or a lynx (Verg. G. 3.264, Lewis &amp; Short); also simply “various” (see “various”)."
    },
    {
      "latin": "pictus, picta, pictum",
      "status": "alternative",
      "period": "classical",
      "gloss": "painted, brightly coloured",
      "register": "vōx plērumque poētica dē avibus: Verg.",
      "evidence": [
        "Verg. A. 4.525: <span lang=\"la\">pecudēs pictaeque volucrēs</span>"
      ]
    },
    {
      "latin": "multicolor, multicolōris",
