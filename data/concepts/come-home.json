      "latin": "domum redīre",
      "status": "recommended",
      "period": "classical",
      "gloss": "come back home, go home",
      "grammar": "domum, accusative of the place to which, without a preposition; redeō, redīre, rediī, reditum",
      "evidence": [
        "Cic. Fam. 7.22: <span lang=\"la\">etsī domum bene pōtus sērōque redieram</span>"
      ],
      "comment": "The plain words for going back to one’s own house; the house record has <span lang=\"la\">domum</span> itself."
    },
    {
      "latin": "domum īre",
      "status": "alternative",
      "period": "classical",
      "gloss": "go home",
      "grammar": "domum with eō, īre (or abeō)",
      "evidence": [
        "Plaut. Asin. 921: <span lang=\"la\">Surge, amātor, ī domum.</span>",
        "Ter. Ad. 699: <span lang=\"la\">Abī domum</span>"
      ]
    }
  ],
  "phrases": [
    {
      "latin": "Jam vesperāscit; domum redeāmus.",
      "english": "It’s getting dark; let’s head home.",
      "source": "composed"
