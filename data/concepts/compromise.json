      "status": "alternative",
      "period": "classical",
      "gloss": "give up part of one’s rights, yield a point",
      "evidence": [
        "Cic. Rosc. Am. 27; Att. 16.2 (Lewis &amp; Short)"
      ]
    },
    {
      "latin": "comprōmissum, comprōmissī n.",
      "status": "avoid",
      "period": "classical",
      "gloss": "an agreement to go to arbitration",
      "evidence": [
        "Cic. Rosc. Com. 12 (Lewis &amp; Short)"
      ],
      "comment": "A false friend: the parties’ promise to abide by an arbiter’s award, a legal term, not a compromise."
