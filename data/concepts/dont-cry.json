  "phrases": [
    {
      "latin": "Nē plōrā, mī fīlī: nihil malī est.",
      "english": "Don’t cry, my boy: nothing’s wrong.",
      "source": "composed"
    },
    {
      "latin": "nē lacrumā atque istuc, quidquid est, fac mē ut sciam",
      "english": "don’t cry, and whatever it is, let me know",
      "source": "Ter. Haut. 84"
    },
    {
      "latin": "Nē flē, mulier. intrō abī, habē animum bonum; ego illam reperiam.",
      "english": "Don’t cry, my dear. Go inside and cheer up; I’ll find her.",
      "source": "Plaut. Epid. 601–602"
    },
