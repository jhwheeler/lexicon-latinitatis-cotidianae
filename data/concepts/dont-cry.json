        "Plaut. Epid. 601: <span lang=\"la\">Nē flē, mulier.</span>"
      ]
    },
    {
      "latin": "Nē lacrimā!",
      "status": "alternative",
      "period": "classical",
      "gloss": "don’t shed tears",
      "evidence": [
        "Ter. Haut. 84: <span lang=\"la\">nē lacrumā</span>",
        "Plaut. Stich. 20: <span lang=\"la\">Nē lacrumā, soror</span>"
