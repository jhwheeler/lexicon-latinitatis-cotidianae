    {
      "latin": "ēvānēscō, ēvānēscere, ēvānuī",
      "status": "recommended",
      "period": "classical",
      "gloss": "fade away, lose strength, die away",
      "evidence": [
        "Lucr. 2.828: <span lang=\"la\">ēvānēscere stinguīque colōrem</span> (Lewis &amp; Short)",
        "Cic. Div. 2.117: <span lang=\"la\">dē vīnō aut salsāmentō putēs loquī, quae ēvānēscunt vetustāte</span>"
      ],
      "comment": "Of a colour, a smell, wine that goes flat, a sound or a memory (<span lang=\"la\">memoria … obscūrāta est et ēvānuit</span>, Cic. de Or. 2.95). It is also the word for vanish (see disappear)."
    },
    {
      "latin": "pallēscō, pallēscere, palluī",
      "status": "alternative",
      "period": "classical",
      "gloss": "grow pale; of leaves, fade",
      "evidence": [
        "Ov. Ars 3.704: <span lang=\"la\">pallēscunt frondēs</span> (Lewis &amp; Short)",
        "Gell. 19.4.4 (Lewis &amp; Short)"
      ],
      "comment": "First of people who turn pale with fear or worry; of leaves and of a flame, losing their colour."
    },
    {
      "latin": "marcēscō, marcēscere",
      "status": "alternative",
      "period": "classical",
      "gloss": "wither, droop",
      "evidence": [
        "Plin. NH 21.2 (Lewis &amp; Short)",
        "Liv. 28.35.3: <span lang=\"la\">equitem marcēscere dēsidiā</span> (Lewis &amp; Short)"
      ],
      "comment": "Of flowers and leaves that wilt; by a figure, of people who grow slack. Not in Cicero or Caesar (Lewis &amp; Short)."
    },
    {
      "latin": "dēflōrēscō, dēflōrēscere, dēflōruī",
      "status": "alternative",
      "period": "classical",
      "gloss": "drop its blossom; fade, decline",
      "evidence": [
        "Catull. 62.43 (Lewis &amp; Short)",
        "Col. 2.11, of corn (Lewis &amp; Short)"
      ],
      "comment": "Of a plant past its flowering, and by a figure of anything past its best: <span lang=\"la\">dēliciae … celeriter dēflōrēscunt</span> (Cic. Cael. 44)."
    }
  ],
