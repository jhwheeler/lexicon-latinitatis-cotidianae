  "phrases": [
    {
      "latin": "Ō Syre noster, salvē: quid fit? quid agitur? — Rēctē. — Optimē est.",
      "english": "Syrus, my friend, hello! What’s new? How are things? — Fine. — Great.",
      "source": "Ter. Ad. 883–884"
    },
    {
      "latin": "usquīn valuistī? — Usque ut vidēs. — Factum optimē.",
      "english": "Have you been well all along? — As you see. — Great.",
      "source": "Plaut. Most. 448–449c"
    },
    {
      "latin": "Euge euge, lepidē, laudō commentum tuom.",
      "english": "Great, great, very neat: I like your plan.",
      "source": "Plaut. Mil. 241b"
    },
    {
      "latin": "Bene hercle factum, et gaudeō.",
