  "terms": [
    {
      "latin": "maeror, maerōris m.",
      "status": "recommended",
      "period": "classical",
      "gloss": "grief, mourning, sorrow",
      "evidence": [
        "Cic. Tusc. 4.8.18: <span lang=\"la\">maeror est aegritūdō flēbilis</span> (Lewis &amp; Short)",
        "Traupman 153, 156, 324"
      ],
      "comment": "Grief that weeps and shows itself: Cicero defines it as a tearful sorrow."
    },
    {
      "latin": "lūgeō, lūgēre, lūxī, lūctum",
      "status": "alternative",
      "period": "classical",
      "gloss": "to mourn",
      "evidence": [
        "Traupman 156"
      ]
    },
    {
      "latin": "condolēscō, condolēscere, condoluī",
      "status": "alternative",
      "period": "classical",
      "gloss": "to feel pain, grieve",
      "evidence": [
        "Traupman 153",
        "Plaut. Truc. 2.8.2: <span lang=\"la\">mihi … condoluit caput</span> (Lewis &amp; Short)",
        "Traupman 324"
      ],
      "comment": "Lewis &amp; Short gives it of physical pain above all (<span lang=\"la\">dēns, pēs condoluit</span>); of grief it is less common."
    },
    {
      "latin": "superō, superāre, superāvī, superātum",
      "status": "alternative",
      "period": "classical",
      "gloss": "to get over, overcome (grief, anger)",
      "evidence": [
        "Traupman 153"
      ]
    },
    {
      "latin": "dolor, dolōris m.",
      "status": "alternative",
      "period": "classical",
      "gloss": "pain, grief",
      "comment": "Pain of body or mind; Cicero sets the two side by side: <span lang=\"la\">maerōrem minuī; dolōrem nec potuī</span> (Cic. Att. 12.28.2, Lewis &amp; Short s.v. <span lang=\"la\">maeror</span>)."
    },
    {
