  "phrases": [
    {
      "latin": "innocēns, sī accūsātus sit, absolvī potest, nocēns, nisi accūsātus fuerit, condemnārī nōn potest",
      "english": "an innocent man, if he is accused, can be acquitted; a guilty one cannot be found guilty unless he has been accused",
      "source": "Cic. Rosc. Am. 56"
    },
    {
      "latin": "Estne absolūtus an condemnātus?",
      "english": "Was he acquitted or found guilty?",
      "source": "Traupman 191"
    },
    {
      "latin": "noxius jūdicārī",
      "english": "to be found guilty",
      "source": "Traupman 195; cf. Liv. 39.41 (Lewis &amp; Short s.v. <span lang=\"la\">noxius</span>)"
    },
    {
      "latin": "poenam dē sontibus exigere",
      "english": "to punish the guilty",
      "source": "Traupman 195"
    },
    {
      "latin": "aliquem multīs crīminibus fraudis convincere",
      "english": "to convict someone on many counts of fraud",
      "source": "Traupman 194"
    },
    {
      "latin": "in culpā esse",
      "english": "to be guilty, be at fault",
      "source": "Traupman 195"
    },
    {
      "latin": "Noxius dījūdicātus est.",
      "english": "He was found guilty.",
      "source": "Traupman 324"
