  "terms": [
    {
      "latin": "sclopētum, sclopētī n.",
      "status": "recommended",
      "period": "modern",
      "gloss": "a gun, a rifle",
      "evidence": [
        "Traupman 52, 324",
        "M-O s.v. gun, rifle, musket (Ducrue 1784)",
        "Traupman 187: rifle"
      ],
      "comment": "From Italian <em>schioppetto</em>, in Latin since the Renaissance (M-O). A hunting rifle is <span lang=\"la\">sclopētum vēnātōrium</span> (M-O, Egger); a pistol <span lang=\"la\">sclopētum minus</span> (M-O, Busbecq). To fire a gun is <span lang=\"la\">sclopētāre</span> (Traupman 324) or <span lang=\"la\">sclopētum displōdere</span> (M-O s.v. shoot)."
    },
    {
      "latin": "tormentum, tormentī n.",
      "status": "alternative",
      "period": "classical",
      "gloss": "a big gun, a cannon; classically a catapult",
      "evidence": [
        "Caes. B.G. 2.8 (Lewis &amp; Short)",
        "Traupman 187",
        "M-O s.v. cannon"
      ],
      "comment": "Classically an engine that hurls missiles, a catapult or ballista (Caes. B.G. 2.8), and the missile it throws; the Renaissance writers used it for artillery (M-O), and so does Traupman. Not for a handgun. Its other common sense is torture, or the rack."
    },
    {
      "latin": "sclopētō, sclopētāre",
      "status": "alternative",
      "period": "modern",
      "gloss": "fire a gun, shoot",
      "evidence": [
        "Traupman 324"
      ]
    }
  ],
