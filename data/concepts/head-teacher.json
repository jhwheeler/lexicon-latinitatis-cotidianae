  "terms": [
    {
      "latin": "scholae rēctor, rēctōris m.",
      "status": "recommended",
      "period": "modern",
      "gloss": "head of a school",
      "evidence": [
        "Traupman 31: <span lang=\"la\">(lūdī or scholae) rēctor</span>, fem. <span lang=\"la\">rēctrīx</span>",
        "Traupman 326"
      ],
      "comment": "<span lang=\"la\">Rēctor</span> is classical for a guide or director (Cic., Lewis &amp; Short); Traupman gives it for the principal, with <span lang=\"la\">lūdī</span> or <span lang=\"la\">scholae</span>, and <span lang=\"la\">rēctrīx</span> for a woman. The head’s office is <span lang=\"la\">rēctōris conclāve</span>."
    },
    {
      "latin": "scholarcha, scholarchae m./f.",
      "status": "alternative",
      "period": "modern",
      "evidence": [
        "Andresian p. 13",
        "M-O s.v. principal, headmaster"
      ],
      "comment": "A Greek-looking coinage, not in Lewis &amp; Short."
    },
    {
      "latin": "gymnasiarchus, gymnasiarchī m.",
      "status": "alternative",
      "period": "classical",
      "gloss": "master of a gymnasium",
      "evidence": [
        "Cic. Verr. 2.4.92 (Lewis &amp; Short)",
        "M-O s.v. principal, headmaster"
      ],
      "comment": "Cicero’s word for the head of a Greek gymnasium; Morgan–Owens takes it for a headmaster. It suits a grammar school better than a primary school."
    },
    {
      "latin": "rēctor (rēctrīx) vicārius (vicāria)",
      "status": "alternative",
      "period": "modern",
      "gloss": "assistant or deputy head",
      "evidence": [
        "Traupman 28, 31, 402"
      ],
      "comment": "<span lang=\"la\">Vicārius</span> is classically a substitute or deputy."
    },
    {
      "latin": "rēctōris (rēctrīcis) officīna",
      "status": "avoid",
      "period": "modern",
      "gloss": "the head’s office",
      "evidence": [
        "Traupman 31"
      ],
      "comment": "<span lang=\"la\">Officīna</span> is classically a workshop or factory (Lewis &amp; Short), not an office; say <span lang=\"la\">conclāve rēctōris</span>."
    }
  ],
