      "latin": "ferula, ferulae f.",
      "status": "alternative",
      "period": "modern",
      "evidence": [
        "Traupman 48"
      ],
      "comment": "Classically a giant-fennel stalk, a light staff or a schoolmaster’s cane (Hor., Juv.)."
    },
    {
      "latin": "virga retorta",
      "status": "alternative",
      "period": "modern",
      "evidence": [
        "M-O s.v. hockey: hockey stick (Mercuriale)"
      ],
      "comment": "“A bent stick”, Mercuriale’s phrase for the stick of polo."
    },
