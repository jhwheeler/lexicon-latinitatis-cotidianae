    {
      "latin": "Quōmodo tibi ministrāre possum?",
      "status": "recommended",
      "period": "modern",
      "gloss": "how can I help you? (a shop assistant to a customer)",
      "evidence": [
        "Traupman 113"
      ],
      "comment": "<span lang=\"la\">Ministrāre</span> is classically to wait on someone, above all at table (<span lang=\"la\">quō commodius tibi ministrētur</span>, Cic. Fam. 16.14.2, Lewis &amp; Short); the shop greeting is Traupman’s. Neither phrase is found in a classical author."
    },
    {
      "latin": "Quōmodo possum tē adjuvāre?",
      "status": "alternative",
      "period": "modern",
      "gloss": "how can I help you?",
      "evidence": [
        "Traupman 128: Quōmodo possum tē juvāre?"
      ],
      "comment": "Traupman writes <span lang=\"la\">juvāre</span>; <span lang=\"la\">adjuvāre</span> is the usual verb for helping someone in a task (see I’ll help you)."
    }
  ],
