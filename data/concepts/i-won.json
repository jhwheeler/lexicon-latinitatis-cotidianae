    {
      "latin": "Vīcī!",
      "status": "recommended",
      "period": "classical",
      "gloss": "I’ve won!",
      "grammar": "perfect of vincō",
      "evidence": [
        "Suet. Jul. 37: <span lang=\"la\">vēnī, vīdī, vīcī</span>"
      ],
      "comment": "The perfect of <span lang=\"la\">vincō</span>: <span lang=\"la\">vīcī</span> “I’ve won”, <span lang=\"la\">vīcistī</span> “you’ve won”, <span lang=\"la\">vīcimus</span> “we’ve won”. Of losing, the passive: <span lang=\"la\">victus sum</span>, <span lang=\"la\">victī sumus</span>. For the verbs, see “win” and “lose”; for a game nobody wins, see “draw”."
    },
    {
      "latin": "Vīcistī.",
      "status": "alternative",
      "period": "classical",
      "gloss": "you’ve won, you win",
      "evidence": [
        "Plaut. Pers. 215: <span lang=\"la\">Jam abī, vīcistī.</span>"
      ],
      "comment": "In Plautus it ends a slanging match: “all right, you win.”"
    },
    {
      "latin": "Victus sum.",
      "status": "alternative",
      "period": "classical",
      "gloss": "I’ve lost",
      "evidence": [
        "Liv. 22.7.8: <span lang=\"la\">pugnā … magnā victī sumus</span>"
      ],
      "comment": "Livy’s praetor announcing a lost battle; in play, said half in jest."
    }
  ],
