  "terms": [
    {
      "latin": "Salvum tē advēnisse gaudeō.",
      "status": "recommended",
      "period": "classical",
      "gloss": "I’m glad you’ve arrived safely",
      "evidence": [
        "Ter. <em>Phorm.</em> 286"
      ],
      "comment": "Said by the one who waits; to a woman <strong lang=\"la\">salvam</strong>, to several <strong lang=\"la\">salvōs vōs</strong>."
    }
  ],
  "phrases": [
    {
      "latin": "Mea māter, salvē. — Gaudeō vēnisse salvum.",
      "english": "Mother, hello. — I’m glad you’ve come back safe (the son arriving, the mother waiting)",
      "source": "Ter. <em>Hec.</em> 353"
    },
    {
      "latin": "Ō pater, pater mī, salvē. — Salvē multum, gnāte mī.",
      "english": "Father, my father, hello! — A hearty hello, my son.",
      "source": "Plaut. <em>Trin.</em> 1180"
    },
    {
      "latin": "Vēnistī! Ō mihi nūntiī beātī!",
      "english": "You’ve come! O happy news for me!",
      "source": "Catull. 9, 5"
    },
    {
      "latin": "Adventus tuus grātissimus est!",
      "english": "Welcome!",
      "source": "Traupman 405"
    },
    {
      "latin": "Salvē, exoptāte gnāte mī.",
      "english": "Hello, my son, how I have longed for you!",
      "source": "Plaut. Capt. 1006"
    },
    {
      "latin": "Salvom gaudeō tē advenīre.",
      "english": "I’m so glad you’ve come safe.",
      "source": "Plaut. Curc. 306–307"
    },
    {
      "latin": "Ō mī gnāte, quam libenter tē videō!",
      "english": "Oh my boy, I’m so happy to see you!",
      "source": "composed"
    }
  ],
