    {
      "latin": "bēstiola, bēstiolae f.",
      "status": "recommended",
      "period": "classical",
      "gloss": "a small creature, a bug",
      "evidence": [
        "Cic. ND 2.123",
        "Varr. RR 1.12.2",
        "M-O s.v. insect"
      ],
      "comment": "The everyday word for any small creature, Cicero’s and Varro’s; <span lang=\"la\">bēstia</span> is the house spelling (see animal)."
    },
    {
      "latin": "īnsectum, īnsectī n.",
      "status": "alternative",
      "period": "classical",
      "gloss": "an insect, in the naturalists’ sense",
      "evidence": [
        "Plin. NH 11.1",
        "Traupman 142, 333, 143",
        "M-O s.v. insect"
      ],
      "comment": "Pliny’s term, from <span lang=\"la\">insecō</span>, to cut into; mostly plural, <span lang=\"la\">īnsecta</span>."
    },
    {
      "latin": "cīmex, cīmicis m.",
      "status": "avoid",
      "period": "classical",
      "gloss": "bedbug",
      "evidence": [
        "Andresian p. 27",
        "Traupman 141",
        "Traupman 284"
      ],
      "comment": "Andresian uses it for any bug, but classically it is the bedbug (see bedbug)."
    }
  ],
