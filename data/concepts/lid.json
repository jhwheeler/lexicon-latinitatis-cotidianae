    },
    {
      "latin": "posteā trānsfunditō in fidēliam pīcātam, operculō tegitō",
      "english": "then pour it into a pitched jar and cover it with a lid",
      "source": "Col. 12.48.3"
    },
    {
      "latin": "Operculum tolle, ut vapor exeat.",
      "english": "Take the lid off to let the steam out.",
