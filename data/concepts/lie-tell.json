  "phrases": [
    {
      "latin": "dīc obsecrō hercle sēriō quod tē rogem, cavē mihi mendācī quicquam",
      "english": "for heaven’s sake, answer me seriously what I ask you, and no lies, mind",
      "source": "Plaut. Asin. 29–30"
    },
    {
      "latin": "hoc juvat et mellī est, nōn mentiar",
      "english": "I won’t lie: I love it, it’s honey to me",
