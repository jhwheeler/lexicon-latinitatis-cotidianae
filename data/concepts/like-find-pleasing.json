  "terms": [
    {
      "latin": "placet (mihi)",
      "status": "recommended",
      "period": "classical",
      "gloss": "I like it, it pleases me",
      "grammar": "impersonal: the thing liked is the subject, the person in the dative",
      "evidence": [
        "Ter. Ad. 911: <span lang=\"la\">Placet, pater lepidissime.</span>",
        "Cic. Att. 2.4.1: <span lang=\"la\">mihi maximē placet</span>",
        "Traupman 102: <span lang=\"la\">hoc mihi placet</span>"
      ],
      "comment": "English “I like this” turns round: <span lang=\"la\">hoc mihi placet</span>, “this pleases me”. “Do you like it?”: <span lang=\"la\">placetne tibi?</span>."
    },
    {
      "latin": "juvat (mē)",
      "status": "alternative",
      "period": "classical",
      "gloss": "I like to, I enjoy (doing)",
      "grammar": "impersonal, with the person in the accusative and an infinitive",
      "evidence": [
        "Hor. S. 2.6.32: <span lang=\"la\">hoc juvat et mellī est</span>",
        "Traupman 102: <span lang=\"la\">mē juvat hoc facere</span>"
      ],
      "comment": "For liking to do something: <span lang=\"la\">mē juvat hoc facere</span>, I like doing this (see enjoy)."
    },
    {
      "latin": "cūrō, cūrāre",
      "status": "avoid",
      "period": "classical",
      "gloss": "care for, look after; not “like”",
      "evidence": [
        "Traupman 340: like (care for), <span lang=\"la\">cūrāre</span>"
      ],
      "comment": "<span lang=\"la\">cūrāre</span> is to take care of, attend to; “I don’t care about it” is <span lang=\"la\">nōn cūrō</span>. For liking a thing, <span lang=\"la\">placet</span> or <span lang=\"la\">dēlectat</span>."
    }
  ],
