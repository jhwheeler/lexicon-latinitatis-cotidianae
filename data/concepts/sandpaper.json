      "latin": "charta harēnāta",
      "status": "recommended",
      "period": "ours",
      "gloss": "sandpaper (literally “sanded paper”)",
      "comment": "Our formation: <span lang=\"la\">charta</span>, paper, with <span lang=\"la\">harēnātus</span>, sanded, covered with sand (Cato Agr. 18.7, of lime mixed with sand). No reference work has a word for sandpaper. What the ancients smoothed with was pumice and the rough skin of fish."
    },
    {
      "latin": "pūmex, pūmicis m.",
      "status": "alternative",
      "period": "classical",
      "gloss": "pumice, the ancient smoothing stone",
      "evidence": [
        "Catull. 1.2: <span lang=\"la\">āridā modo pūmice expolītum</span>",
        "Hor. Ep. 1.20.2 (Lewis &amp; Short)"
      ],
      "comment": "Book rolls were smoothed with pumice; masculine in prose, feminine in Catullus. See “pumice”."
    }
  ],
  "phrases": [
    {
      "latin": "Chartā harēnātā marginem lēvigā.",
      "english": "Smooth the edge with sandpaper.",
      "source": "composed"
    },
    {
      "latin": "Cui dōnō lepidum novum libellum āridā modo pūmice expolītum?",
      "english": "To whom shall I give my charming new little book, just smoothed off with dry pumice?",
