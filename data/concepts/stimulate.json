    {
      "latin": "stimulō, stimulāre, stimulāvī, stimulātum",
      "status": "recommended",
      "period": "classical",
      "gloss": "spur on, stimulate",
      "grammar": "verb, first conjugation, transitive",
      "evidence": [
        "Liv. 1.22.2: <span lang=\"la\">avīta glōria animum stimulābat</span> (Lewis &amp; Short)"
      ],
      "comment": "From <span lang=\"la\">stimulus</span>, a goad: to spur someone on to act. It also means to torment, to give no peace (Cic. Rosc. Am. 6); context decides. The noun <span lang=\"la\">stimulus</span> is a stimulus in the same two senses."
    },
    {
      "latin": "acuō, acuere, acuī, acūtum",
      "status": "alternative",
      "period": "classical",
      "gloss": "sharpen, stimulate (the mind); spur on",
      "grammar": "verb, third conjugation, transitive",
      "evidence": [
        "Ter. Ad. 5.3.49: <span lang=\"la\">illōs sat aetās acuet</span> (Lewis &amp; Short)",
        "Cic. Att. 2.7 (Lewis &amp; Short)"
      ],
      "comment": "Literally to sharpen a blade; then to sharpen the wits (<span lang=\"la\">mentem, ingenium</span>) and to rouse a person."
    },
    {
      "latin": "incitō, incitāre, incitāvī, incitātum",
      "status": "alternative",
      "period": "classical",
      "gloss": "spur on, quicken; make grow faster",
      "grammar": "verb, first conjugation, transitive",
      "evidence": [
        "Col. 4.22.3: <span lang=\"la\">ut incitārī vītis possit</span> (Lewis &amp; Short)"
      ],
      "comment": "To set going fast, to urge on; of plants and rivers, to make grow or swell. The noun <span lang=\"la\">incitāmentum</span> is an incentive (Cic. Arch. 23; Tac.)."
    }
  ],
