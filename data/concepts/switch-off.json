    {
      "latin": "exstinguō, exstinguere",
      "status": "recommended",
      "period": "modern",
      "gloss": "extinguish",
      "comment": "Using it for electrical lights is a modern application. Traupman and Andresian use it for switching off a computer or a phone too.",
      "evidence": [
        "Traupman 262, s.v. turn off",
        "Andresian pp. 14–15",
        "Traupman 262, 399"
      ]
    },
