  "phrases": [
    {
      "latin": "sī dē quīncūnce remōta est ūncia, quid superat? … — triēns. — eu! rem poteris servāre tuam. redit ūncia, quid fit? — sēmis",
      "english": "If one twelfth is taken from five twelfths, what is left? — A third. — Well done! You’ll be able to look after your money. Put the twelfth back: what does it make? — A half.",
      "source": "Hor. Ars 327–330"
    },
    {
      "latin": "Pygmaeōs quoque haut longē ab hīs nāscī, quōrum quī longissimī sint, nōn longiōrēs esse quam pedēs duo et quadrantem",
      "english": "and that the Pygmies are born not far from them, the tallest of whom are no more than two and a quarter feet tall",
      "source": "Gell. 9.4.11"
    }
  ],
  "notes": {
    "uncia": {
      "form": "<span lang=\"la\">ūncia</span>",
      "claim": "long u",
      "against": "Lewis &amp; Short leaves it unmarked",
      "html": "Bennett §52: “like <span lang=\"la\">ūnus</span>”, from which Varro derives it (<span lang=\"la\">ūncia ab ūnō</span>, LL 5.171; de Vaan s.v. <span lang=\"la\">ūnus</span>). The Romance words (Italian <span lang=\"la\">oncia</span>, Spanish <span lang=\"la\">onza</span>) point to a short vowel in later Latin; Rosen, <span lang=\"la\">Language</span> 40 (1964) 21–22, takes <span lang=\"la\">*oiniciā</span> through <span lang=\"la\">*ūnciā</span>, with a later shortening."
    },
    "unx": {
      "form": "<span lang=\"la\">quīncūnx, septūnx, deūnx</span>",
      "claim": "long u, from ūncia",
      "against": "Lewis &amp; Short leaves it unmarked",
      "html": "Bennett §52 (each “from <span lang=\"la\">ūncia</span>”) and §42.4, where the compounds in <span lang=\"la\">-ūnx</span> are among the exceptions to his rule that a third-declension word ending in two consonants has a short vowel. <span lang=\"la\">deūnx</span> keeps the short <span lang=\"la\">de-</span> before a vowel (Lewis &amp; Short <span lang=\"la\">dĕ-unx</span>)."
    },
    "dextans": {
      "form": "<span lang=\"la\">dēxtāns</span>",
      "claim": "long e",
      "against": "Lewis &amp; Short leaves it unmarked",
      "html": "From <span lang=\"la\">dē</span> + <span lang=\"la\">sextāns</span>, the <span lang=\"la\">as</span> less a sixth (Bennett §52; Lewis &amp; Short gives the same derivation). The vowel before <span lang=\"la\">ns</span> is long."
    }
