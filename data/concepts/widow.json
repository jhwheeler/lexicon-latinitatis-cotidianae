    {
      "latin": "vidua, viduae f.",
      "status": "recommended",
      "period": "classical",
      "gloss": "a widow; more widely, any woman without a husband",
      "evidence": [
        "Plaut. Mil. 964–965: <span lang=\"la\">Nūptan' est an vidua?</span>",
        "Cic. Caecin. 14: <span lang=\"la\">cognitor viduārum</span> (Lewis &amp; Short)"
      ],
      "comment": "In comedy the word covers the woman who has left her husband or never had one: <span lang=\"la\">quīn vidua vīvam quam tuōs mōrēs perferam</span> (Plaut. Men. 726)."
    },
    {
      "latin": "viduus, vidua, viduum",
      "status": "alternative",
      "period": "classical",
      "gloss": "widowed; left without a husband or a wife",
      "evidence": [
        "Plaut. Merc. 4.6.13: <span lang=\"la\">viduī virī</span> (Lewis &amp; Short)",
        "Plaut. Stich. 1.1.2 (Lewis &amp; Short)"
      ],
      "comment": "A widower is <span lang=\"la\">vir viduus</span>."
    }
  ],
  "phrases": [
    {
      "latin": "Nūptan' est an vidua? — Et nūpta et vidua.",
      "english": "Is she married or without a husband? — Both married and without a husband.",
      "source": "Plaut. Mil. 964–965"
    }
  ],
