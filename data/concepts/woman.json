    {
      "latin": "mulier, mulieris f.",
      "status": "recommended",
      "period": "classical",
      "gloss": "a woman (as opposed to a man); also a wife",
      "evidence": [
        "Traupman 408"
      ],
      "comment": "<span lang=\"la\">mulier</span> is the everyday word, often of a married woman; <span lang=\"la\">fēmina</span> is the female of the species and the respectful word; a lady is <span lang=\"la\">mātrōna</span> (see lady)."
    },
    {
      "latin": "fēmina, fēminae f.",
      "status": "alternative",
      "period": "classical",
      "gloss": "a woman, a female"
    },
    {
      "latin": "muliercula, mulierculae f.",
      "status": "alternative",
      "period": "classical",
      "gloss": "a little woman; a silly woman (belittling)",
      "evidence": [
        "Cic. Tusc. 5.103: <span lang=\"la\">aquam ferentis mulierculae</span> (Lewis &amp; Short s.v. <span lang=\"la\">susurrus</span>)",
        "Traupman 408",
        "Traupman 410"
      ],
      "comment": "Traupman gives it for “young woman” and “young lady”; classically the diminutive is usually belittling or pitying, “a poor little woman”. For a girl or young woman, <span lang=\"la\">puella</span> or <span lang=\"la\">virgō</span>."
    }
  ],
